<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Steps uses Bluetooth to add a friend when you hold your phones together.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_steps-friends._tcp</string>
		<string>_steps-friends._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Steps uses the camera to scan a friend’s code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Steps finds a nearby phone when you both have Friends open.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Steps uses proximity to add a friend when you hold your phones together.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
</dict>
</plist>
